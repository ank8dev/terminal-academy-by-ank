# Terminal Academy (t//a) Expanded Color Palette Specification

BRAND_ANCHOR:
  PRIMARY: "#ff5500" # Vivid Safety Orange

STRUCTURAL_SPECTRUM:
  BURNT_AMBER: "#b45309" # Layered text highlight and warning alerts
  NEON_RUST: "#ca8a04" # Dynamic path highlights and terminal indicators
  SAFETY_ORANGE_GLOW: "rgba(255, 85, 0, 0.15)" # Backdrop glow matrix
  DARK_CHARCOAL_ORANGE: "#1c0c04" # Widget boundaries and borders
  DEEP_ORANGE_DARK: "#0f0502" # Dark panel background accents
  AMBER_GLOW: "rgba(180, 83, 9, 0.1)" # Outer card glow layers
